				Button {
					id: bt00
					x :0
					y :20
					width: 70
					height: 20
					text: "openloop"
					onClicked:{
						//Tablero.setText(textInputthruster2.text)
						if(bt00.text == "openloop"){
							//Tablero.setLed(13,'H')
							text = "closeloop";
							//rect1.visible = false
							mqttvalue.thrusterMode("closeloop")
							del1.visible = true
							orifice1_target.visible = true
							del2.visible = true
							orifice2_target.visible = true
							del3.visible = true
							orifice3_target.visible = true
							del4.visible = true
							orifice4_target.visible = true
							
				
						}else
						if(bt00.text == "closeloop"){
							//Tablero.setLed(13,'L')
